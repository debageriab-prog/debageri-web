rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // Verify the caller has a valid session cookie verified server-side.
    // Admin access is enforced in API routes via Firebase Admin SDK.
    // These rules are the last line of defence — never rely on them alone.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── jobs ────────────────────────────────────────────────────────────────
    // Public: read published jobs only.
    // Write: admin only.

    match /jobs/{jobId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // ── applications ────────────────────────────────────────────────────────
    // All access goes through server Route Handlers using the Admin SDK.

    match /applications/{applicationId} {
      allow read, write: if false;
    }

    // ── contact messages ──────────────────────────────────────────────────
    // All access goes through server Route Handlers and Server Actions using
    // the Admin SDK. Contact details are never exposed to browser Firestore clients.

    match /contactMessages/{messageId} {
      allow read, write: if false;
    }

    // ── admins ──────────────────────────────────────────────────────────────
    // Read / write: admin only.

    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // ── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
